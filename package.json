{
  "name": "@agentregistrar/discovery",
  "version": "1.1.0",
  "description": "Agent Identity v1 (agent-identity-v1) discovery schema and conformance validator",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "agent-signup.schema.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentregistrar/spec.git"
  },
  "keywords": [
    "agent-identity",
    "agentregistrar",
    "discovery",
    "agent-signup",
    "conformance"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "validate:discovery": "tsx src/validate-discovery.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
