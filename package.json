{
  "name": "@agentregistrar/discovery",
  "version": "2.2.1",
  "description": "Agent Identity Protocol (agent-identity-protocol) discovery, attestation source, RP attestation, broker metadata and attestation-status schemas, plus the conformance and attestation-source validator",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": "./dist/cli.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agent-signup.schema.json": "./agent-signup.schema.json",
    "./attestation-source.schema.json": "./attestation-source.schema.json",
    "./rp-attestation.schema.json": "./rp-attestation.schema.json",
    "./broker-metadata.schema.json": "./broker-metadata.schema.json",
    "./attestation-status.schema.json": "./attestation-status.schema.json",
    "./signup-receipt.schema.json": "./signup-receipt.schema.json",
    "./abuse-report.schema.json": "./abuse-report.schema.json",
    "./registry/implementations.schema.json": "./registry/implementations.schema.json"
  },
  "files": [
    "dist",
    "agent-signup.schema.json",
    "attestation-source.schema.json",
    "rp-attestation.schema.json",
    "broker-metadata.schema.json",
    "attestation-status.schema.json",
    "signup-receipt.schema.json",
    "abuse-report.schema.json",
    "registry/implementations.schema.json",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentregistrar/spec.git"
  },
  "keywords": [
    "agent-identity",
    "agentregistrar",
    "discovery",
    "agent-signup",
    "conformance",
    "attestation",
    "relying-party"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "check:release": "node scripts/check-release.mjs",
    "validate:discovery": "tsx src/validate-discovery.ts",
    "validate:fixtures": "tsx src/validate-fixtures.ts",
    "validate:registry": "tsx src/validate-registry.ts",
    "sign:fixtures": "tsx src/dev/sign-fixtures.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0"
}
