{
  "protocol": "agent-identity-protocol",
  "protocol_version": "2.0",
  "audience": "vaporcloud",
  "provider_name": "VaporCloud",
  "issuer_allowlist": [
    "https://id.agentregistrar.dev"
  ],
  "required_scopes": [
    "tos:accept"
  ],
  "terms": {
    "version": "2026.1",
    "url": "https://vaporcloud.example/terms"
  },
  "endpoints": {
    "agent_signup": "https://vaporcloud.example/api/signup/agent",
    "agent_login": "https://vaporcloud.example/api/login/agent"
  }
}
