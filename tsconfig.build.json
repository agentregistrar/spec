{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "noEmit": false,
    "incremental": false,
    "allowJs": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/dev/**"]
}
